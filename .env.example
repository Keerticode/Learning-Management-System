# LMS Server — Environment Variables (EXAMPLE)
# Copy to `.env` and replace placeholders with actual values.
# Never commit `.env`. Production values are configured in the Render dashboard.

# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/lms_dev

# JWT — Access and rotating refresh tokens
# In production, both secrets must be at least 32 characters and different.
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary — Video and image hosting
# All CLOUDINARY_* values are required in production.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mail — Password reset and email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="LMS Platform <no-reply@example.com>"

# Redis — Shared rate limiting across API instances
# Optional. Without REDIS_URL, the rate limiter uses an in-memory store.
# Local: docker run --rm -p 6379:6379 redis:alpine
REDIS_URL=redis://127.0.0.1:6379

# Initial admin — Used by npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_6_chars
ADMIN_NAME=Platform Admin

# CORS — Comma-separated allowed origins.
# CLIENT_URL is automatically included. Wildcard origins are not allowed in production.
CORS_ORIGINS=http://localhost:5173

# Password hashing
# Allowed range: 10–14
BCRYPT_ROUNDS=12

# Account lockout
# Locks accounts after consecutive failed login attempts.
MAX_LOGIN_ATTEMPTS=10
LOCK_DURATION_MIN=15

# Email verification and password reset expiration
EMAIL_VERIFICATION_TTL_MIN=1440
PASSWORD_RESET_TTL_MIN=15

# Refresh-token cookie — HttpOnly cookie
REFRESH_COOKIE_NAME=lms.refresh

# Logging
LOG_LEVEL=info

# Feature flags
# Server-side flags must match their corresponding client-side defaults.
# Client-side variants use the VITE_FEATURE_* prefix in client/.env.
FEATURE_CERTIFICATES=true
FEATURE_HLS=false
FEATURE_BETA_QUIZ_TIMER=false